package = com.lingmarket.openiconrenderer.simd
headers = oir_simd.h
headerFilter = oir_simd.h
compilerOpts = -O3
compilerOpts.linux_x64 = -O3 -mavx2 -mpopcnt -mbmi2 -mfma
compilerOpts.mingw_x64 = -O3 -mavx2 -mpopcnt -mbmi2 -mfma
compilerOpts.linux_arm64 = -O3 -march=armv8-a+simd
compilerOpts.macos_arm64 = -O3
---
#include "oir_simd.h"
#include <math.h>
#include <stdint.h>
#include <string.h>

#if defined(__AVX2__)
#include <immintrin.h>
#endif

/* ---------------- PNG pack ---------------- */

#if defined(__AVX2__)
static inline void pack_row_avx2(const int32_t *src, uint8_t *dst, int width) {
    const __m256i shuffle = _mm256_setr_epi8(
        2, 1, 0, 3,  6, 5, 4, 7,  10, 9, 8, 11,  14, 13, 12, 15,
        2, 1, 0, 3,  6, 5, 4, 7,  10, 9, 8, 11,  14, 13, 12, 15);
    int x = 0;
    for (; x + 8 <= width; x += 8) {
        __m256i v = _mm256_loadu_si256((const __m256i *)(src + x));
        __m256i p = _mm256_shuffle_epi8(v, shuffle);
        _mm256_storeu_si256((__m256i *)(dst + x * 4), p);
    }
    for (; x < width; x++) {
        uint32_t c = (uint32_t)src[x];
        dst[x * 4 + 0] = (uint8_t)(c >> 16);
        dst[x * 4 + 1] = (uint8_t)(c >> 8);
        dst[x * 4 + 2] = (uint8_t)c;
        dst[x * 4 + 3] = (uint8_t)(c >> 24);
    }
}
#else
static inline void pack_row_avx2(const int32_t *src, uint8_t *dst, int width) {
    for (int x = 0; x < width; x++) {
        uint32_t c = (uint32_t)src[x];
        dst[x * 4 + 0] = (uint8_t)(c >> 16);
        dst[x * 4 + 1] = (uint8_t)(c >> 8);
        dst[x * 4 + 2] = (uint8_t)c;
        dst[x * 4 + 3] = (uint8_t)(c >> 24);
    }
}
#endif

void oir_pack_argb_to_rgba_filter_none(
    const int32_t *pixels,
    uint8_t *raw,
    int32_t width,
    int32_t height
) {
    if (width <= 0 || height <= 0) return;
    int stride = 1 + width * 4;
    for (int y = 0; y < height; y++) {
        uint8_t *row = raw + (size_t)y * (size_t)stride;
        row[0] = 0;
        pack_row_avx2(pixels + (size_t)y * (size_t)width, row + 1, width);
    }
}

/* ---------------- gradient spans ---------------- */

static inline int lut_index_from_t(float t) {
    if (t <= 0.f) return 0;
    if (t >= 1.f) return 255;
    int i = (int)(t * 255.f + 0.5f);
    if (i < 0) return 0;
    if (i > 255) return 255;
    return i;
}

#if defined(__AVX2__)
static inline __m256i lut_gather8(const int32_t *lut, __m256 t) {
    const __m256 zero = _mm256_setzero_ps();
    const __m256 one = _mm256_set1_ps(1.f);
    const __m256 scale = _mm256_set1_ps(255.f);
    const __m256 half = _mm256_set1_ps(0.5f);
    t = _mm256_min_ps(_mm256_max_ps(t, zero), one);
    __m256 scaled = _mm256_fmadd_ps(t, scale, half);
    __m256i idx = _mm256_cvttps_epi32(scaled);
    idx = _mm256_min_epi32(_mm256_max_epi32(idx, _mm256_setzero_si256()), _mm256_set1_epi32(255));
    return _mm256_i32gather_epi32(lut, idx, 4);
}
#endif

void oir_fill_linear_lut_span(
    int32_t *pixels,
    int32_t start,
    int32_t count,
    const int32_t *lut,
    float t0,
    float dt
) {
    if (count <= 0) return;
    int32_t *dst = pixels + start;
    int i = 0;
#if defined(__AVX2__)
    if (count >= 8) {
        __m256 t = _mm256_setr_ps(
            t0, t0 + dt, t0 + 2.f * dt, t0 + 3.f * dt,
            t0 + 4.f * dt, t0 + 5.f * dt, t0 + 6.f * dt, t0 + 7.f * dt);
        const __m256 d8 = _mm256_set1_ps(8.f * dt);
        for (; i + 8 <= count; i += 8) {
            __m256i colors = lut_gather8(lut, t);
            _mm256_storeu_si256((__m256i *)(dst + i), colors);
            t = _mm256_add_ps(t, d8);
        }
        t0 += (float)i * dt;
    }
#endif
    for (; i < count; i++) {
        dst[i] = lut[lut_index_from_t(t0)];
        t0 += dt;
    }
}

void oir_fill_radial_lut_span(
    int32_t *pixels,
    int32_t start,
    int32_t count,
    const int32_t *lut,
    float x0_center,
    float y,
    float cx,
    float cy,
    float invR
) {
    if (count <= 0) return;
    int32_t *dst = pixels + start;
    if (invR <= 0.f) {
        int32_t c = lut[0];
        for (int i = 0; i < count; i++) dst[i] = c;
        return;
    }
    const float dy = y - cy;
    const float dy2 = dy * dy;
    int i = 0;
#if defined(__AVX2__)
    if (count >= 8) {
        __m256 x = _mm256_setr_ps(
            x0_center, x0_center + 1.f, x0_center + 2.f, x0_center + 3.f,
            x0_center + 4.f, x0_center + 5.f, x0_center + 6.f, x0_center + 7.f);
        const __m256 cxv = _mm256_set1_ps(cx);
        const __m256 dy2v = _mm256_set1_ps(dy2);
        const __m256 inv = _mm256_set1_ps(invR);
        const __m256 eight = _mm256_set1_ps(8.f);
        for (; i + 8 <= count; i += 8) {
            __m256 dx = _mm256_sub_ps(x, cxv);
            __m256 r2 = _mm256_fmadd_ps(dx, dx, dy2v);
            __m256 t = _mm256_mul_ps(_mm256_sqrt_ps(r2), inv);
            __m256i colors = lut_gather8(lut, t);
            _mm256_storeu_si256((__m256i *)(dst + i), colors);
            x = _mm256_add_ps(x, eight);
        }
    }
#endif
    for (; i < count; i++) {
        float dx = (x0_center + (float)i) - cx;
        float t = invR * sqrtf(dx * dx + dy2);
        dst[i] = lut[lut_index_from_t(t)];
    }
}
