package = com.lingmarket.openiconrenderer.simd
headers = oir_simd.h
headerFilter = oir_simd.h
# Portable scalar only: AVX2 bitcode currently crashes Kotlin/Native LLVM 21
# ("Do not know how to split the result of this operator!") when linked into
# lingmarket-back release binaries.
compilerOpts = -O2
---
#include "oir_simd.h"
#include <math.h>
#include <stdint.h>
#include <string.h>

static inline void pack_row(const int32_t *src, uint8_t *dst, int width) {
    for (int x = 0; x < width; x++) {
        uint32_t c = (uint32_t)src[x];
        dst[x * 4 + 0] = (uint8_t)(c >> 16);
        dst[x * 4 + 1] = (uint8_t)(c >> 8);
        dst[x * 4 + 2] = (uint8_t)c;
        dst[x * 4 + 3] = (uint8_t)(c >> 24);
    }
}

void oir_pack_argb_to_rgba_filter_none(
    const int32_t *pixels,
    uint8_t *raw,
    int32_t width,
    int32_t height
) {
    if (width <= 0 || height <= 0) return;
    int stride = 1 + width * 4;
    for (int y = 0; y < height; y++) {
        uint8_t *row = raw + (size_t)y * (size_t)stride;
        row[0] = 0;
        pack_row(pixels + (size_t)y * (size_t)width, row + 1, width);
    }
}

static inline int lut_index_from_t(float t) {
    if (t <= 0.f) return 0;
    if (t >= 1.f) return 255;
    int i = (int)(t * 255.f + 0.5f);
    if (i < 0) return 0;
    if (i > 255) return 255;
    return i;
}

void oir_fill_linear_lut_span(
    int32_t *pixels,
    int32_t start,
    int32_t count,
    const int32_t *lut,
    float t0,
    float dt
) {
    if (count <= 0) return;
    int32_t *dst = pixels + start;
    for (int i = 0; i < count; i++) {
        dst[i] = lut[lut_index_from_t(t0)];
        t0 += dt;
    }
}

void oir_fill_radial_lut_span(
    int32_t *pixels,
    int32_t start,
    int32_t count,
    const int32_t *lut,
    float x0_center,
    float y,
    float cx,
    float cy,
    float invR
) {
    if (count <= 0) return;
    int32_t *dst = pixels + start;
    if (invR <= 0.f) {
        int32_t c = lut[0];
        for (int i = 0; i < count; i++) dst[i] = c;
        return;
    }
    const float dy = y - cy;
    const float dy2 = dy * dy;
    for (int i = 0; i < count; i++) {
        float dx = (x0_center + (float)i) - cx;
        float t = invR * sqrtf(dx * dx + dy2);
        dst[i] = lut[lut_index_from_t(t)];
    }
}
